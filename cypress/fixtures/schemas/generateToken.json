{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "POST /Account/v1/GenerateToken - 200 (sucesso)",
  "type": "object",
  "additionalProperties": false,
  "required": ["token", "expires", "status", "result"],
  "properties": {
    "token": { "type": "string", "pattern": "^[\\w-]+\\.[\\w-]+\\.[\\w-]+$" },
    "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "status": { "const": "Success" },
    "result": { "const": "User authorized successfully." }
  }
}
