{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "book.json",
  "title": "Livro (compartilhado por GET /BookStore/v1/Books e GET /Account/v1/User/{UUID})",
  "type": "object",
  "additionalProperties": false,
  "required": ["isbn", "title", "subTitle", "author", "publish_date", "publisher", "pages", "description", "website"],
  "properties": {
    "isbn": { "type": "string", "pattern": "^[0-9]{10,13}$" },
    "title": { "type": "string", "minLength": 1 },
    "subTitle": { "type": "string" },
    "author": { "type": "string", "minLength": 1 },
    "publish_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "publisher": { "type": "string" },
    "pages": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "website": { "type": "string" }
  }
}
