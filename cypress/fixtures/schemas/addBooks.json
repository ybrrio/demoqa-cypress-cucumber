{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "POST /BookStore/v1/Books - 201",
  "type": "object",
  "additionalProperties": false,
  "required": ["books"],
  "properties": {
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["isbn"],
        "properties": { "isbn": { "type": "string", "pattern": "^[0-9]{10,13}$" } }
      }
    }
  }
}
