{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resposta de erro padrão da API",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": { "type": "string", "pattern": "^[0-9]+$" },
    "message": { "type": "string", "minLength": 1 }
  }
}
