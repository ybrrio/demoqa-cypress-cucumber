{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /Account/v1/User/{UUID} - 200",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "username", "books"],
  "properties": {
    "userId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "username": { "type": "string", "minLength": 1 },
    "books": {
      "type": "array",
      "items": { "$ref": "book.json" }
    }
  }
}
